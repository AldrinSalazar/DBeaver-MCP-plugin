<?xml version="1.0" encoding="UTF-8"?>
<!--
  Plain unit tests (no OSGi runtime needed). Requires the DBeaver jars
  registered by scripts/install-dbeaver-libs.* (model + utils only).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.astronauta</groupId>
    <artifactId>dbeaver-mcp-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>dev.astronauta.dbeaverMCP.tests</artifactId>
  <packaging>jar</packaging>

  <name>DBeaver MCP Server (tests)</name>

  <dependencies>
    <dependency>
      <groupId>dev.astronauta</groupId>
      <artifactId>dev.astronauta.dbeaverMCP</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.modelcontextprotocol.sdk</groupId>
      <artifactId>mcp</artifactId>
      <version>${mcp.version}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jetty</groupId>
      <artifactId>jetty-server</artifactId>
      <version>${jetty.version}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jetty.ee10</groupId>
      <artifactId>jetty-ee10-servlet</artifactId>
      <version>${jetty.version}</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>dbeaver.local</groupId>
      <artifactId>org.jkiss.dbeaver.model</artifactId>
      <version>${dbeaver.local.version}</version>
    </dependency>
    <dependency>
      <groupId>dbeaver.local</groupId>
      <artifactId>org.jkiss.utils</artifactId>
      <version>${dbeaver.local.version}</version>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>21</release>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.0.0</version>
      </plugin>
    </plugins>
  </build>
</project>
