# Maven / Tycho build outputs
target/
# Staged third-party jars (regenerated by the build)
lib/
# Tycho working state inside modules
.m2/
# Local scratch space (toolchains, caches)
.tmp/
# Release archives if ever copied to the repo root
*.zip

# Logs
*.log

# Eclipse / PDE
.classpath
.project
.settings/
bin/

# IntelliJ
.idea/
*.iml

# Editors / OS
.vscode/
.DS_Store
*Zone.Identifier
