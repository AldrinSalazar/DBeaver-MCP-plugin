Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: DBeaver MCP Server
Bundle-SymbolicName: dev.astronauta.dbeaverMCP;singleton:=true
Bundle-Version: 0.1.1.qualifier
Bundle-Vendor: astronauta
Bundle-Activator: dev.astronauta.dbeaverMCP.McpPlugin
Bundle-ActivationPolicy: lazy
Bundle-RequiredExecutionEnvironment: JavaSE-21
Require-Bundle: org.jkiss.dbeaver.model,
 org.jkiss.dbeaver.model.jdbc,
 org.jkiss.utils,
 org.eclipse.equinox.common,
 org.eclipse.equinox.preferences,
 org.eclipse.core.runtime,
 org.eclipse.core.commands,
 org.eclipse.jface,
 org.eclipse.ui,
 org.eclipse.ui.workbench
Import-Package: org.eclipse.swt.graphics,
 org.eclipse.swt.widgets,
 org.osgi.framework,
 org.osgi.service.prefs
Bundle-ClassPath: .,
 lib/mcp-2.0.1.jar,
 lib/mcp-json-jackson3-2.0.1.jar,
 lib/jackson-databind-3.1.4.jar,
 lib/jackson-core-3.1.4.jar,
 lib/json-schema-validator-3.0.6.jar,
 lib/itu-1.14.0.jar,
 lib/jackson-dataformat-yaml-3.1.4.jar,
 lib/snakeyaml-engine-3.0.1.jar,
 lib/mcp-core-2.0.1.jar,
 lib/jackson-annotations-2.21.jar,
 lib/reactor-core-3.7.0.jar,
 lib/reactive-streams-1.0.4.jar,
 lib/jetty-server-12.1.13.jar,
 lib/jetty-http-12.1.13.jar,
 lib/jetty-util-12.1.13.jar,
 lib/jetty-io-12.1.13.jar,
 lib/slf4j-api-2.0.17.jar,
 lib/jetty-ee10-servlet-12.1.13.jar,
 lib/jakarta.servlet-api-6.0.0.jar,
 lib/jetty-security-12.1.13.jar,
 lib/jetty-session-12.1.13.jar,
 lib/slf4j-simple-2.0.19.jar
